generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum VIDEO_STATUS {
  PENDING
  FETCHING_METADATA
  FETCHING_TRANSCRIPT
  PROCESSING_TRANSCRIPT
  GENERATING_EMBEDDINGS
  READY
  FAILED
}

enum ERROR_CODE {
  INVALID_VIDEO
  VIDEO_UNAVAILABLE
  TRANSCRIPT_NOT_AVAILABLE
  METADATA_FETCH_FAILED
  TRANSCRIPT_PROCESSING_FAILED
  EMBEDDING_FAILED
}

enum TRANSCRIPT_SOURCE {
  YOUTUBE_CAPTIONS
  AUTO_GENERATED_CAPTIONS
  SPEECH_TO_TEXT
}

enum MESSAGE_ROLE {
  USER
  ASSISTANT
  SYSTEM
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name  String
  email String @unique

  passwordHash String?

  image String?

  provider AuthProvider @default(LOCAL)

  googleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedVideos   SavedVideo[]
  conversations Conversation[]
}


model Video {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  youtubeId    String   @unique
  url          String
  title        String?
  description  String?
  tags         String[]
  categoryId   String?
  channelId    String?
  channelTitle String?
  thumbnailUrl String?

  defaultLanguage      String?
  defaultAudioLanguage String?

  duration    Int?
  publishedAt DateTime?

  viewCount    Int?
  likeCount    Int?
  commentCount Int?

  status       VIDEO_STATUS @default(PENDING)
  errorCode    ERROR_CODE?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  savedBy       SavedVideo[]
  transcript    Transcript?
  conversations Conversation[]
}

model SavedVideo {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId  String @db.ObjectId
  videoId String @db.ObjectId

  savedAt        DateTime  @default(now())
  lastAccessedAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model Transcript {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  videoId String @unique @db.ObjectId

  language String?
  source   TRANSCRIPT_SOURCE

  fullText String

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  video     Video             @relation(fields: [videoId], references: [id])
  chunks    TranscriptChunk[]
}

model TranscriptChunk {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  transcriptId String @db.ObjectId

  content String

  // Timestamp in seconds
  startTime  Float
  endTime    Float
  chunkIndex Int
  embedding  Float[]

  createdAt DateTime @default(now())

  transcript Transcript @relation(fields: [transcriptId], references: [id])

  @@unique([transcriptId, chunkIndex])
  @@index([transcriptId])
}

model Conversation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId  String @db.ObjectId
  videoId String @db.ObjectId

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  video    Video     @relation(fields: [videoId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([videoId])
}

model Message {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  conversationId String @db.ObjectId

  role           MESSAGE_ROLE
  content        String
  sourceChunkIds String[]     @db.ObjectId

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String
  subject   String
  content   String
  createdAt DateTime @default(now())
}